{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unihelp:esquema:insumos:1.0.0",
  "title": "InsumosAnalisis",
  "description": "Artefactos distintos de la traza que consume el analisis. Los marcados `provisional` en experiment/metricas.yaml se fijan cuando exista su productor (juez, calificacion humana, microbenchmark, corrida de control); hoy solo los produce el generador sintetico.",
  "$defs": {
    "veredicto": {
      "enum": ["aprobado", "reprobado"]
    },
    "m6Arquitectura": { "enum": ["B0", "B1", "B2", "B3"] },
    "m6Repositorio": {
      "description": "m6/repositorio.json: archivos del diff m6-base..m6/<arq> de la sexta herramienta (M6.1, M6.2, decision 60).",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "rama_base", "implementaciones"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "rama_base": { "type": "string", "minLength": 1 },
        "implementaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arquitectura", "rama", "commit", "archivos"],
            "properties": {
              "arquitectura": { "$ref": "#/$defs/m6Arquitectura" },
              "rama": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "minLength": 1 },
              "archivos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ruta", "estado", "clase", "anadidas", "eliminadas"],
                  "properties": {
                    "ruta": { "type": "string", "minLength": 1 },
                    "estado": { "enum": ["A", "M", "D", "R", "C"] },
                    "clase": { "enum": ["fuente", "configuracion", "documentacion", "prueba", "generado"] },
                    "anadidas": { "type": "integer", "minimum": 0 },
                    "eliminadas": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "m6VerificacionManual": {
      "description": "m6/verificacion-manual.json: marcas de la bitacora con reloj monotono (M6.4) y servicios reiniciados en la verificacion practica (M6.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "rama_base", "implementaciones"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "rama_base": { "type": "string", "minLength": 1 },
        "implementaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arquitectura", "marcas", "servicios_reiniciados"],
            "properties": {
              "arquitectura": { "$ref": "#/$defs/m6Arquitectura" },
              "servicios_reiniciados": {
                "description": "null si la verificacion practica no se hizo.",
                "type": ["array", "null"],
                "items": { "type": "string", "minLength": 1 }
              },
              "marcas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["fase", "evento", "monotono_ns"],
                  "properties": {
                    "fase": { "type": "string", "minLength": 1 },
                    "evento": { "enum": ["inicio", "fin"] },
                    "monotono_ns": { "type": "integer", "minimum": 0 },
                    "reloj_iso": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "m6IntegracionContinua": {
      "description": "m6/integracion-continua.json: pnpm verify en cada rama y pruebas previas editadas (M6.5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "rama_base", "implementaciones"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "rama_base": { "type": "string", "minLength": 1 },
        "implementaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arquitectura", "suite_verde", "pruebas_previas_editadas"],
            "properties": {
              "arquitectura": { "$ref": "#/$defs/m6Arquitectura" },
              "suite_verde": { "type": "boolean" },
              "objetivos_fallidos": { "type": "array", "items": { "type": "string" } },
              "pruebas_previas_editadas": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "puntuacion": {
      "description": "Una linea de puntuaciones.jsonl: compuerta automatica + juez por ejecucion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "exito"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "exito": {
          "description": "Supero la compuerta automatica (eliminatoria) y el juez la aprobo.",
          "type": "boolean"
        },
        "compuerta_automatica": { "type": "boolean" },
        "veredicto_juez": { "enum": ["aprobado", "reprobado", null] },
        "motivos": {
          "description": "Verificaciones de la compuerta automatica que fallaron (por ejemplo `herramienta_prohibida:crear_ticket_simulado`). Vacio si la compuerta se supero. Sin esto una corrida dice cuantas ejecuciones fallaron, pero no por que.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tarifas": {
      "description": "tarifas.yaml: precio de lista por modelo, en USD por millon de tokens (M4.7, decision 50).",
      "type": "object",
      "required": ["version", "moneda", "unidad", "consultado_el", "modelos"],
      "properties": {
        "version": { "type": "string" },
        "moneda": { "const": "USD" },
        "unidad": { "const": "por_millon_de_tokens" },
        "consultado_el": { "type": "string", "format": "date" },
        "modelos": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entrada", "entrada_cacheada", "salida", "fuente"],
            "properties": {
              "entrada": { "type": "number", "minimum": 0 },
              "entrada_cacheada": { "type": "number", "minimum": 0 },
              "salida": { "type": "number", "minimum": 0 },
              "fuente": { "type": "string", "minLength": 1 },
              "nota": { "type": "string" }
            }
          }
        }
      }
    },
    "huellasEsperadas": {
      "description": "huellas-esperadas.json: huella de estado inicial esperada por tarea.",
      "type": "object",
      "additionalProperties": false,
      "required": ["huellas"],
      "properties": {
        "dataset_version": { "type": "string" },
        "huellas": {
          "type": "object",
          "propertyNames": { "pattern": "^T-(INF|DIA|COM|ADV)-[0-9]{3}$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "benchTransporte": {
      "description": "bench-transport.json. Guarda TODAS las iteraciones; el analisis descarta las de calentamiento.",
      "type": "object",
      "additionalProperties": false,
      "required": ["iteraciones_calentamiento", "transportes"],
      "properties": {
        "generado_en": { "type": "string", "format": "date-time" },
        "iteraciones_calentamiento": { "type": "integer", "minimum": 0 },
        "transportes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nombre", "latencias_ms"],
            "properties": {
              "nombre": { "type": "string", "minLength": 1 },
              "latencias_ms": {
                "type": "array",
                "items": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "calificacionHumana": {
      "description": "Una linea de calificacion-humana.jsonl: los dos revisores a ciegas y el veredicto adjudicado.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "task_id",
        "veredicto_revisor_a",
        "veredicto_revisor_b",
        "veredicto_adjudicado"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "pattern": "^T-(INF|DIA|COM|ADV)-[0-9]{3}$" },
        "veredicto_revisor_a": { "$ref": "#/$defs/veredicto" },
        "veredicto_revisor_b": { "$ref": "#/$defs/veredicto" },
        "veredicto_adjudicado": { "$ref": "#/$defs/veredicto" }
      }
    },
    "veredictoJuez": {
      "description": "Una linea de veredictos-juez.jsonl.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "veredicto"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "veredicto": { "$ref": "#/$defs/veredicto" },
        "puntos_cubiertos": { "type": "array", "items": { "type": "string" } },
        "prohibiciones_violadas": { "type": "array", "items": { "type": "string" } },
        "puntos_sin_respaldo": {
          "description": "Puntos clave cuya informacion no estaba en lo que recupero el agente (prompt v2, decision 53).",
          "type": "array",
          "items": { "type": "string" }
        },
        "abstencion": { "type": "boolean" }
      }
    },
    "controlInstrumentacion": {
      "description": "Una linea de control-instrumentacion.jsonl: la misma submuestra con instrumentacion completa y minima.",
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "repetition", "instrumentacion", "total_ms"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^T-(INF|DIA|COM|ADV)-[0-9]{3}$" },
        "repetition": { "type": "integer", "minimum": 1 },
        "instrumentacion": { "enum": ["completa", "minima"] },
        "total_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
