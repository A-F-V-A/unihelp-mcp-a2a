{
  "name": "analisis",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "experiment/analisis",
  "tags": ["tipo:experimento"],
  "// targets": "Python gestionado con uv (decision 20). Ninguna metrica se calcula fuera de aqui (decision 19).",
  "targets": {
    "instalar": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "uv sync", "cwd": "experiment" }
    },
    "fixtures": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "uv run python fixtures/generador.py", "cwd": "experiment" }
    },
    "ejecutar": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "uv run papermill analisis.ipynb salidas/analisis.ejecutado.ipynb --cwd .",
        "cwd": "experiment"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "uv run pytest", "cwd": "experiment" }
    }
  }
}
