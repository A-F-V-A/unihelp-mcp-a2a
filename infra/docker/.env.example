# ===========================================================================
# UniHelp - configuracion de la orquestacion local
# ===========================================================================
# Copiar como `.env` en esta misma carpeta:
#
#   cp infra/docker/.env.example infra/docker/.env
#
# Con COMPOSE_PROFILES definido basta `docker compose up --build`, sin pasar
# --profile: esa es la UNICA variable que decide cual arquitectura se levanta.
# ===========================================================================

# Arquitectura activa: b0 | b1 | b2 | b3
COMPOSE_PROFILES=b0

# Version con la que se etiquetan las imagenes y que reporta /health.
UNIHELP_VERSION=0.1.0

# Puerto del host en el que queda publicado el backend de entrada de la
# arquitectura activa. El frontend apunta aqui.
PUERTO_BACKEND=3000

# Puerto del host para el frontend Angular.
PUERTO_WEB=4200

# URL que el NAVEGADOR usa para llamar al backend activo.
# Debe coincidir con PUERTO_BACKEND.
BACKEND_URL=http://localhost:3000

# Origen permitido por CORS en los backends ('*' es suficiente en local).
CORS_ORIGEN=*

# Puertos auxiliares, utiles solo para inspeccionar servicios de B3/MCP aparte.
PUERTO_B3_CONOCIMIENTO=3004
PUERTO_B3_DIAGNOSTICO=3005
PUERTO_MCP=3010

# PostgreSQL de la base de conocimiento (profile `conocimiento`). Solo local:
# los datos son sinteticos y viven en tmpfs.
PUERTO_POSTGRES=5432
POSTGRES_USER=unihelp
POSTGRES_PASSWORD=unihelp
POSTGRES_DB=unihelp
