# Variables del servidor MCP para desarrollo local. Copiar como
# `apps/mcp-server/.env` (ignorado por git). Detalle en
# apps/b1-mcp-agente/docs/ARQUITECTURA.md.

# PostgreSQL del profile `conocimiento` (pnpm conocimiento:db): la misma base
# que usa B0, porque las capacidades son el mismo codigo.
CONOCIMIENTO_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp
TICKETS_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp

# Limite de llamadas a herramientas por ejecucion (RNF-04; docs/02, 5). En B1 el
# receptor es este servidor: debe valer lo mismo que en B0. 20 por defecto.
# UNIHELP_LIMITE_LLAMADAS_HERRAMIENTA=20

# Puerto (3010 por defecto, docs/arquitecturas.md).
# PORT=3010
