# Copia este archivo como `.env` (no se versiona) para desarrollo local.
#
# El simulador NO tiene datos propios: publica el estado de servicios de la base
# de conocimiento, la misma que leen los agentes (decision 33). Por eso lo unico
# que necesita es la URL de PostgreSQL.
CONOCIMIENTO_DATABASE_URL=postgresql://unihelp:unihelp@localhost:5432/unihelp

# Conmutar el estado inicial BORRA y repuebla la base de conocimiento, asi que
# `POST /simulacion/estado-inicial` solo existe con este perfil (HU-36).
# Sin el, el simulador queda de solo lectura.
UNIHELP_PERFIL=experimento

# Puerto del simulador. Por defecto 3020.
# PORT=3020
