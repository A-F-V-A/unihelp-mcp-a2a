{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["tipo:app", "arq:frontend"],
  "// assets": "En produccion, `datos-experimento/*` se copia como assets estaticos (tareas, corrida.yaml, salidas y corridas). En desarrollo NO: el servidor de desarrollo recargaria la pagina cada vez que el ejecutor escribe una traza; en su lugar `proxy.conf.json` reenvia `/datos-experimento` a la consola del experimento, que sirve los mismos archivos de disco (decisiones 38 y 39).",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": [
          "apps/web/src/styles.css",
          "apps/web/src/app/presentation/experimento/experimento.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/web/public"
            },
            {
              "glob": "T-*.yaml",
              "input": "docs/tasks",
              "output": "/datos-experimento/tareas"
            },
            {
              "glob": "corrida.yaml",
              "input": "experiment/ejecutor",
              "output": "/datos-experimento/ejecutor"
            },
            {
              "glob": "**/*.{json,svg,csv}",
              "input": "experiment/salidas",
              "output": "/datos-experimento/salidas"
            },
            {
              "glob": "**/*.{json,jsonl,md}",
              "input": "experiment/corridas",
              "output": "/datos-experimento/corridas"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/environment.ts",
              "with": "apps/web/src/environments/environment.development.ts"
            }
          ]
        },
        "backend-real": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "allowedHosts": ["localhost.afva.com.co"],
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        },
        "backend-real": {
          "buildTarget": "web:build:backend-real"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web/jest.config.cts",
        "tsConfig": "apps/web/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    }
  }
}
