# Variables del orquestador de B3 para desarrollo local. Copiar como
# `apps/b3-a2a-orquestador/.env` (ignorado por git) y completar la clave.
# NUNCA versionar la clave real.
#
# B3 y B2 deben ser identicos salvo el transporte entre agentes (RNF-01, H3), y
# ambos comparables con B0 y B1: modelo, muestreo, modo de casetes y limites
# llevan LOS MISMOS valores que apps/b0-directo/.env, tambien en los dos
# especialistas (apps/b3-a2a-conocimiento/.env, apps/b3-a2a-diagnostico/.env).

PORT=3003
# Donde esta el servidor MCP (pnpm dev:b3 lo levanta en :3010): herramientas de
# tickets con X-Agent-Id: orquestador (HU-20).
MCP_SERVER_URL=http://localhost:3010
# URL con la que otros procesos alcanzan a este (va en la Agent Card).
A2A_SELF_URL=http://localhost:3003
# Registro de descubrimiento (HU-29): URL base de cada especialista, cuyas Agent
# Cards se consultan al arrancar y, si faltan, al delegar.
A2A_REGISTRY_PATH=apps/b3-a2a-orquestador/config/a2a-registry.yaml
A2A_CONOCIMIENTO_URL=http://localhost:3004
A2A_DIAGNOSTICO_URL=http://localhost:3005

# Credencial del proveedor. No se exige con UNIHELP_MODO_LLM=replay (HU-44).
OPENAI_API_KEY=

# Modelo: identificador exacto con fecha de snapshot (RNF-08). Igual que en B0.
UNIHELP_MODELO_PROVEEDOR=openai
# Modelo local con Ollama (decision 46; `pnpm ollama:crear` lo construye). No
# necesita OPENAI_API_KEY. Sus cifras se reportan aparte de las de OpenAI.
# UNIHELP_MODELO_PROVEEDOR=ollama
# UNIHELP_MODELO_ID=unihelp-qwen2.5:7b-instruct-q4_K_M-ctx16k
# UNIHELP_MODELO_URL_BASE=http://localhost:11434/v1
UNIHELP_MODELO_ID=gpt-5.5-2026-04-23
# UNIHELP_MODELO_ESFUERZO=none
UNIHELP_MODELOS_PERMITIDOS=gpt-5.4-mini-2026-03-17,gpt-5.4-2026-03-05,gpt-4.1-mini-2025-04-14
# UNIHELP_MODELO_TEMPERATURA=0.2
# UNIHELP_MODELO_TOP_P=1
# UNIHELP_MODELO_MAX_TOKENS=2048

# live | record | replay (HU-39). record y replay exigen UNIHELP_DIRECTORIO_CASETES.
UNIHELP_MODO_LLM=live
# UNIHELP_DIRECTORIO_CASETES=experiment/casetes/b3

# `experimento` habilita las rutas del ejecutor (restablecer y traza). NUNCA en datos reales.
# UNIHELP_PERFIL=experimento

# Limites de RNF-04. El limite de llamadas a herramientas lo aplica mcp-server
# (su UNIHELP_LIMITE_LLAMADAS_HERRAMIENTA), compartido por los tres agentes.
# UNIHELP_LIMITE_TIEMPO_MS=120000
# UNIHELP_LIMITE_TURNOS=8

# PostgreSQL del profile `conocimiento`. El orquestador la usa para lo que NO son
# las cinco capacidades: registro del turno literal, botones del frontend,
# lecturas fuera del chat y rutas del ejecutor (igual que B0, B1 y B2).
CONOCIMIENTO_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp
TICKETS_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp
