# Variables de B0 para desarrollo local. Copiar como `apps/b0-directo/.env`
# (ignorado por git) y completar la clave. NUNCA versionar la clave real.
# Detalle y valores por defecto: apps/b0-directo/docs/ARQUITECTURA.md, seccion 11.

# Credencial del proveedor. No se exige con UNIHELP_MODO_LLM=replay (HU-44).
OPENAI_API_KEY=

# Modelo: identificador exacto con fecha de snapshot (RNF-08).
UNIHELP_MODELO_PROVEEDOR=openai
UNIHELP_MODELO_ID=gpt-5.5-2026-04-23
# Esfuerzo de razonamiento (decision 40): none | low | medium | high. Con GPT-5.x
# solo `none` admite temperatura y herramientas en Chat Completions; es el valor
# por defecto y el unico comparable con la linea base de gpt-5.4-mini.
# UNIHELP_MODELO_ESFUERZO=none
# Modelos que la pantalla de configuracion puede elegir, ademas del de arriba
# (decision 27). Todos con fecha de snapshot; las corridas usan UNIHELP_MODELO_ID.
UNIHELP_MODELOS_PERMITIDOS=gpt-5.4-mini-2026-03-17,gpt-5.4-2026-03-05,gpt-4.1-mini-2025-04-14
# Opcionales (docs/07, seccion 2): 0.2, 1 y 2048 por defecto.
# UNIHELP_MODELO_TEMPERATURA=0.2
# UNIHELP_MODELO_TOP_P=1
# UNIHELP_MODELO_MAX_TOKENS=2048

# live | record | replay (HU-39). record y replay exigen UNIHELP_DIRECTORIO_CASETES.
UNIHELP_MODO_LLM=live
# UNIHELP_DIRECTORIO_CASETES=experiment/casetes/b0

# `experimento` habilita las rutas de `RUTAS_EXPERIMENTO` que consume el
# ejecutor (restablecer el entorno y leer la traza de una ejecucion) y el
# restablecimiento de conocimiento y de tickets. Fuera de ese perfil el
# controlador ni se registra: son 404 (decision 29). NUNCA en datos reales.
# UNIHELP_PERFIL=experimento

# Limites de RNF-04. Opcionales: 120000 ms, 8 turnos y 20 llamadas por conversacion.
# UNIHELP_LIMITE_TIEMPO_MS=120000
# UNIHELP_LIMITE_TURNOS=8
# UNIHELP_LIMITE_LLAMADAS_HERRAMIENTA=20

# PostgreSQL del profile `conocimiento` (pnpm conocimiento:db).
CONOCIMIENTO_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp
TICKETS_DATABASE_URL=postgres://unihelp:unihelp@localhost:5432/unihelp
